{
  "info": {
    "name": "SubTrack API",
    "description": "End-to-end checks for the SubTrack API (see SubTrack_Project_Plan.md §6). Requests run in order as one user journey: register a fresh random user, manage a subscription, mark a billing period paid, read the dashboard, then clean up.\n\nRun: postman collection run postman/SubTrack.postman_collection.json -e postman/SubTrack.local.postman_environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every JSON error from the app uses the standard body (GlobalExceptionHandler).",
          "// Plain-text 403s come from Spring's CORS filter (request from another site) and are expected.",
          "const isJson = (pm.response.headers.get('Content-Type') || '').includes('application/json');",
          "if (isJson && pm.response.code >= 400 && pm.response.code !== 401 && pm.response.code !== 429) {",
          "  pm.test('Error body has status and message', () => {",
          "    const b = pm.response.json();",
          "    pm.expect(b.status).to.eql(pm.response.code);",
          "    pm.expect(b.message).to.be.a('string');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Unauthenticated request is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 without a token', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.collectionVariables.set('email', `postman-${id}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a bearer access token', () => {",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expiresIn).to.eql(900);",
                  "});",
                  "pm.test('New user is unverified, India timezone by default', () => {",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.user.emailVerified).to.eql(false);",
                  "  pm.expect(body.user.timezone).to.eql('Asia/Kolkata');",
                  "});",
                  "pm.test('Refresh token is an httpOnly cookie, not in the body', () => {",
                  "  const header = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(header).to.include('subtrack_refresh=');",
                  "  pm.expect(header.toLowerCase()).to.include('httponly');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Register again with same email is 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login with wrong password is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('Generic message (no hint whether the email exists)', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh rotates the session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('New access token issued', () => pm.expect(pm.response.json().accessToken).to.be.a('string'));",
                  "pm.test('New refresh cookie issued', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.include('subtrack_refresh='));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Origin", "value": "{{frontendUrl}}" }],
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Refresh from another site is 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 Forbidden (CSRF protection)', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Origin", "value": "https://evil.example" }],
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Is the registered user', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/me" }
        },
        {
          "name": "Update profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Changes saved', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.name).to.eql('Postman Tester Two');",
                  "  pm.expect(b.timezone).to.eql('Asia/Kolkata');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester Two\",\n  \"phone\": \"+91 98765 43210\",\n  \"timezone\": \"Asia/Kolkata\"\n}"
            },
            "url": "{{baseUrl}}/api/users/me"
          }
        }
      ]
    },
    {
      "name": "2. Subscriptions",
      "item": [
        {
          "name": "Create subscription",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Due 5 days from today (UTC date is close enough for a 5-day gap)",
                  "const d = new Date(Date.now() + 5 * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('dueDate', d);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Anchored on the entered due date', () => {",
                  "  pm.expect(b.nextDueDate).to.eql(pm.collectionVariables.get('dueDate'));",
                  "  pm.expect(b.anchorDate).to.eql(pm.collectionVariables.get('dueDate'));",
                  "  pm.expect(b.status).to.eql('ACTIVE');",
                  "});",
                  "pm.test('Monthly defaults to 7/3/1 day reminders', () => pm.expect(b.reminderDays).to.eql([7, 3, 1]));",
                  "pm.test('Monthly amount computed', () => pm.expect(Number(b.monthlyAmount)).to.eql(649));",
                  "pm.collectionVariables.set('subscriptionId', b.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Netflix\",\n  \"category\": \"OTT\",\n  \"amount\": 649,\n  \"billingCycle\": \"MONTHLY\",\n  \"nextDueDate\": \"{{dueDate}}\",\n  \"autoRenew\": false,\n  \"notes\": \"Created by Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/subscriptions"
          }
        },
        {
          "name": "Invalid subscription is 400 with field errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Field errors for name, amount, nextDueDate', () => {",
                  "  const f = pm.response.json().fieldErrors;",
                  "  pm.expect(f).to.have.property('name');",
                  "  pm.expect(f).to.have.property('amount');",
                  "  pm.expect(f).to.have.property('nextDueDate');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"category\": \"OTT\",\n  \"amount\": -1,\n  \"billingCycle\": \"MONTHLY\"\n}"
            },
            "url": "{{baseUrl}}/api/subscriptions"
          }
        },
        {
          "name": "List subscriptions (search)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Paged shape', () => pm.expect(b).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages'));",
                  "pm.test('Finds the new subscription', () => {",
                  "  pm.expect(b.content.map(s => s.id)).to.include(pm.collectionVariables.get('subscriptionId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/subscriptions?q=netf&category=OTT",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subscriptions"],
              "query": [
                { "key": "q", "value": "netf" },
                { "key": "category", "value": "OTT" }
              ]
            }
          }
        },
        {
          "name": "Update reminders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('De-duplicated, sorted high to low', () => pm.expect(pm.response.json().reminderDays).to.eql([10, 2]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"days\": [2, 10, 10] }" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/reminders"
          }
        },
        {
          "name": "Pause",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Paused', () => pm.expect(pm.response.json().status).to.eql('PAUSED'));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"PAUSED\" }" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/status"
          }
        },
        {
          "name": "Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Active again', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"ACTIVE\" }" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/status"
          }
        }
      ]
    },
    {
      "name": "3. Billing periods (Paid / Missed)",
      "item": [
        {
          "name": "List periods",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const periods = pm.response.json();",
                  "pm.test('One current PENDING period, due soon', () => {",
                  "  pm.expect(periods).to.have.length(1);",
                  "  pm.expect(periods[0].paymentStatus).to.eql('PENDING');",
                  "  pm.expect(periods[0].displayStatus).to.eql('DUE_SOON');",
                  "  pm.expect(periods[0].current).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('periodId', periods[0].id);"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/periods" }
        },
        {
          "name": "Missed before due date is 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"MISSED\" }" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/periods/{{periodId}}"
          }
        },
        {
          "name": "Mark paid (early)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Period is PAID with the amount paid', () => {",
                  "  pm.expect(b.period.paymentStatus).to.eql('PAID');",
                  "  pm.expect(Number(b.period.amountPaid)).to.eql(649);",
                  "});",
                  "pm.test('Subscription moved to its next due date', () => {",
                  "  pm.expect(b.subscription.nextDueDate).to.not.eql(pm.collectionVariables.get('dueDate'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"PAID\", \"amountPaid\": 649, \"note\": \"UPI\" }" },
            "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/periods/{{periodId}}"
          }
        },
        {
          "name": "Period history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('One change: PENDING -> PAID', () => {",
                  "  const h = pm.response.json();",
                  "  pm.expect(h).to.have.length(1);",
                  "  pm.expect(h[0].oldStatus).to.eql('PENDING');",
                  "  pm.expect(h[0].newStatus).to.eql('PAID');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/periods/{{periodId}}/history" }
        }
      ]
    },
    {
      "name": "4. Dashboard",
      "item": [
        {
          "name": "Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('Counts the new subscription and payment', () => {",
                  "  pm.expect(s.activeCount).to.eql(1);",
                  "  pm.expect(Number(s.monthlyCommitment)).to.eql(649);",
                  "  pm.expect(s.overdueCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/summary" }
        },
        {
          "name": "Status board",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('One row with the next cycle pending', () => {",
                  "  const rows = pm.response.json();",
                  "  pm.expect(rows).to.have.length(1);",
                  "  pm.expect(rows[0].attention.paymentStatus).to.eql('PENDING');",
                  "  pm.expect(rows[0].lastClosed.paymentStatus).to.eql('PAID');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/status-board" }
        },
        {
          "name": "Category breakdown",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('OTT only', () => pm.expect(pm.response.json().map(c => c.category)).to.eql(['OTT']));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/category-breakdown" }
        },
        {
          "name": "Trend (12 months)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('12 months, current month has the payment', () => {",
                  "  const t = pm.response.json();",
                  "  pm.expect(t).to.have.length(12);",
                  "  pm.expect(t[11].paidCount).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard/trend?months=12" }
        },
        {
          "name": "Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Paged shape', () => pm.expect(pm.response.json()).to.include.keys('content', 'totalElements'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/notifications" }
        }
      ]
    },
    {
      "name": "5. Jobs endpoint",
      "item": [
        {
          "name": "Jobs without secret is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "url": "{{baseUrl}}/internal/jobs/run" }
        }
      ]
    },
    {
      "name": "6. Clean up",
      "item": [
        {
          "name": "Delete subscription (soft)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}" }
        },
        {
          "name": "Deleted subscription is 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}" }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Origin", "value": "{{frontendUrl}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        },
        {
          "name": "Refresh after logout is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401: the session was revoked', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
