# Copy to .env (git-ignored) or set as environment variables.
# Local defaults already work; these matter for deployment.

# Backend
DB_URL=jdbc:mysql://localhost:3306/subtrack?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=subtrack
DB_PASSWORD=subtrack
JWT_SECRET=replace-with-at-least-64-random-characters
JOB_SECRET=replace-with-a-long-random-string
APP_FRONTEND_URL=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=SubTrack <no-reply@subtrack.local>

# Frontend (frontend/.env.local)
VITE_API_URL=http://localhost:8080
